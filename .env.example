# Firebase Web App public configuration (not an Admin SDK key or account password).
# Copy this file to .env.local and fill the four required fields from Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional Firebase Web App fields.
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Keep the same value across deployments so existing data stays accessible.
VITE_APP_ID=ming-jii-default

# Local development only. Leave false for production.
VITE_USE_EMULATORS=false
VITE_ANONYMOUS_DEMO=true
